              name="Urban Furniture Accounting"
              web_icon="urban_furniture_accounting,static/description/icon.png"
              sequence="10"/>

    <!-- Budgets Category Menu -->
    <menuitem id="menu_uf_budget_main"
              name="Budgets"
              parent="menu_uf_accounting_root"
              sequence="10"/>

    <!-- Budgets Item -->
