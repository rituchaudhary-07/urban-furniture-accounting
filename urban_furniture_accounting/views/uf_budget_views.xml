<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_uf_budget_tree" model="ir.ui.view">
        <field name="name">uf.budget.tree</field>
        <field name="model">uf.budget</field>
        <field name="arch" type="xml">
            <tree string="Budgets" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="budget_name"/>
                <field name="analytic_account_id"/>
                <field name="responsible_user_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="planned_amount" widget="monetary"/>
                <field name="actual_amount" widget="monetary"/>
                <field name="variance" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_uf_budget_form" model="ir.ui.view">
        <field name="name">uf.budget.form</field>
        <field name="model">uf.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="budget_name" class="oe_edit_only"/>
                        <h1>
                            <field name="budget_name" placeholder="e.g. Q3 Office Furniture Budget"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Budget Allocation">
                            <field name="analytic_account_id"/>
                            <field name="responsible_user_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Period Range">
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                    </group>
                    <group string="Financial Comparison">
                        <group>
                            <field name="planned_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="actual_amount" widget="monetary"/>
                            <field name="variance" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pivot View ("Budget Report") -->
    <record id="view_uf_budget_pivot" model="ir.ui.view">
        <field name="name">uf.budget.pivot</field>
        <field name="model">uf.budget</field>
        <field name="arch" type="xml">
            <pivot string="Budget Report">
                <field name="analytic_account_id" type="row"/>
                <field name="period_start" type="col" interval="month"/>
                <field name="planned_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_uf_budget_graph" model="ir.ui.view">
        <field name="name">uf.budget.graph</field>
        <field name="model">uf.budget</field>
        <field name="arch" type="xml">
            <graph string="Budget Analysis" type="bar">
                <field name="analytic_account_id"/>
                <field name="planned_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="variance" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_uf_budget_search" model="ir.ui.view">
        <field name="name">uf.budget.search</field>
        <field name="model">uf.budget</field>
        <field name="arch" type="xml">
            <search string="Search Budgets">
                <field name="budget_name"/>
                <field name="analytic_account_id"/>
                <field name="responsible_user_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Analytic Account" name="group_analytic" context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Responsible Person" name="group_responsible" context="{'group_by': 'responsible_user_id'}"/>
                    <filter string="Period Start" name="group_period_start" context="{'group_by': 'period_start:month'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_uf_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">uf.budget</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_uf_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Urban Furniture Budget!
            </p>
            <p>
                Track planned expenditure against real posted journal transactions.
            </p>
        </field>
    </record>

    <record id="action_uf_budget_report" model="ir.actions.act_window">
        <field name="name">Budget Report</field>
        <field name="res_model">uf.budget</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="view_id" ref="view_uf_budget_pivot"/>
        <field name="search_view_id" ref="view_uf_budget_search"/>
    </record>
</odoo>
