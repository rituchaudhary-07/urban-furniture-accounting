<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Partners / Contacts -->
        <record id="partner_vendor_rahul" model="res.partner">
            <field name="name">Rahul Sharma</field>
            <field name="supplier_rank">1</field>
            <field name="email">rahul.sharma@vendor.com</field>
            <field name="street">123 Industrial Area</field>
            <field name="city">Mumbai</field>
            <field name="country_id" ref="base.in"/>
        </record>

        <record id="partner_customer_nimesh" model="res.partner">
            <field name="name">Nimesh Pathak</field>
            <field name="customer_rank">1</field>
            <field name="email">nimesh.pathak@customer.com</field>
            <field name="street">456 Commerce Road</field>
            <field name="city">Ahmedabad</field>
            <field name="country_id" ref="base.in"/>
        </record>

        <!-- Products -->
        <record id="product_wooden_chair" model="product.product">
            <field name="name">Wooden Chair</field>
            <field name="type">consu</field>
            <field name="lst_price">150.00</field>
            <field name="standard_price">80.00</field>
        </record>

        <record id="product_office_chair" model="product.product">
            <field name="name">Office Chair</field>
            <field name="type">consu</field>
            <field name="lst_price">250.00</field>
            <field name="standard_price">120.00</field>
        </record>

        <!-- Analytic Account -->
        <record id="analytic_account_furniture" model="account.analytic.account">
            <field name="name">Urban Furniture Operations</field>
        </record>

        <!-- Budget -->
        <record id="budget_quarterly_operations" model="uf.budget">
            <field name="budget_name">Q3 Furniture Operations Budget</field>
            <field name="period_start" eval="time.strftime('%Y-01-01')"/>
            <field name="period_end" eval="time.strftime('%Y-12-31')"/>
            <field name="responsible_user_id" ref="base.user_admin"/>
            <field name="analytic_account_id" ref="analytic_account_furniture"/>
            <field name="planned_amount">5000.00</field>
            <field name="state">confirmed</field>
        </record>
    </data>
</odoo>
